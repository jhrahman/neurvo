<div class="neurvo-avatar-presets" data-test-selector="avatar-preset-gallery">
  <%= render(Primer::Beta::Subhead.new(mb: 2, mt: 4)) do |subhead| %>
    <% subhead.with_heading(tag: :h4, size: :medium) { t("avatars.label_choose_preset") } %>
    <% subhead.with_description { t("avatars.text_choose_preset") } %>
  <% end %>

  <%= form_with(url: preset_path, method: :put, data: { turbo: false }) do %>
    <div class="neurvo-avatar-presets--grid" role="list">
      <% presets.each do |preset| %>
        <button type="submit"
                name="key"
                value="<%= preset[:key] %>"
                role="listitem"
                class="neurvo-avatar-presets--item"
                title="<%= preset[:label] %>"
                aria-label="<%= t("avatars.label_use_preset", name: preset[:label]) %>"
                data-test-selector="avatar-preset-<%= preset[:key] %>">
          <img src="<%= avatar_preset_path(key: preset[:key], format: :png) %>"
               width="64" height="64" alt="" loading="lazy">
        </button>
      <% end %>
    </div>
  <% end %>
</div>
