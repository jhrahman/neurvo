diff --git a/src/plugins/code-block-delete.ts b/src/plugins/code-block-delete.ts
new file mode 100644
index 0000000..ea16fcc
--- /dev/null
+++ b/src/plugins/code-block-delete.ts
@@ -0,0 +1,48 @@
+import { Plugin } from '@ckeditor/ckeditor5-core';
+import type { DowncastDispatcher, ModelElement, ViewUIElement } from '@ckeditor/ckeditor5-engine';
+
+const TRASH_ICON = '<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M11 1.75V3h2.25a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1 0-1.5H5V1.75C5 .784 5.784 0 6.75 0h2.5C10.216 0 11 .784 11 1.75ZM6.5 1.75V3h3V1.75a.25.25 0 0 0-.25-.25h-2.5a.25.25 0 0 0-.25.25ZM4.997 6.178a.75.75 0 1 0-1.493.144l.684 7.084A1.75 1.75 0 0 0 5.926 15h4.148a1.75 1.75 0 0 0 1.738-1.594l.684-7.084a.75.75 0 0 0-1.493-.144l-.684 7.084a.25.25 0 0 1-.245.244H5.926a.25.25 0 0 1-.245-.244L4.997 6.178Z"/></svg>';
+
+export default class CodeBlockDelete extends Plugin {
+	static get pluginName() {
+		return 'OPCodeBlockDelete';
+	}
+
+	init() {
+		const editor = this.editor;
+
+		editor.conversion.for( 'editingDowncast' ).add( ( dispatcher: DowncastDispatcher ) => {
+			dispatcher.on( 'insert:codeBlock', ( _evt, data, conversionApi ) => {
+				const modelElement = data.item as ModelElement;
+				const preElement = conversionApi.mapper.toViewElement( modelElement );
+				if ( !preElement ) {
+					return;
+				}
+
+				const writer = conversionApi.writer;
+				const label = window.I18n?.t( 'js.editor.code_block.delete' ) ?? 'Delete code block';
+				const button = writer.createUIElement( 'button', {
+					class: 'op-code-block-delete',
+					type: 'button',
+					'aria-label': label,
+					title: label
+				}, function ( this: ViewUIElement, domDocument: Document ) {
+					const dom = this.toDomElement( domDocument );
+					dom.innerHTML = TRASH_ICON;
+					dom.addEventListener( 'mousedown', ( event: Event ) => {
+						event.preventDefault();
+						event.stopPropagation();
+						editor.model.change( modelWriter => {
+							modelWriter.remove( modelElement );
+						} );
+						editor.editing.view.focus();
+					} );
+
+					return dom;
+				} );
+
+				writer.insert( writer.createPositionAt( preElement, 'end' ), button );
+			}, { priority: 'low' } );
+		} );
+	}
+}
