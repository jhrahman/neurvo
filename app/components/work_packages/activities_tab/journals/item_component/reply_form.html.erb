<div class="op-reply-form" data-test-selector="op-wp-journal-<%= journal.id %>-reply">
  <button type="button"
          class="op-reply-form--trigger"
          data-work-packages--activities-tab--comment-thread-target="trigger"
          data-action="work-packages--activities-tab--comment-thread#open"
          data-test-selector="op-wp-journal-<%= journal.id %>-reply-trigger">
    <%= render(Primer::Beta::Octicon.new(icon: :reply, size: :small, mr: 1)) %>
    <%= t(:button_reply) %>
  </button>

  <div class="op-reply-form--form" hidden data-work-packages--activities-tab--comment-thread-target="panel">
  <%= form_with(
        url: create_path,
        method: :post,
        data: {
          turbo: true,
          turbo_stream: true,
          controller: "work-packages--activities-tab--comment-submit",
          "work-packages--activities-tab--comment-thread-target": "form",
          action: "submit->work-packages--activities-tab--comment-thread#prepare " \
                  "turbo:submit-start->work-packages--activities-tab--comment-submit#start " \
                  "turbo:submit-end->work-packages--activities-tab--comment-submit#finish " \
                  "turbo:submit-end->work-packages--activities-tab--comment-thread#done"
        }
      ) do %>
    <%= hidden_field_tag :reply_to_id, journal.id %>
    <%= hidden_field_tag :filter, filter %>
    <%= hidden_field_tag :last_update_timestamp, "", data: { "work-packages--activities-tab--comment-thread-target": "timestamp" } %>
    <%= text_area_tag "journal[notes]",
                      nil,
                      id: nil,
                      rows: 3,
                      required: true,
                      placeholder: t("activities.work_packages.activity_tab.reply_placeholder"),
                      "aria-label": t(:button_reply),
                      class: "form-control op-reply-form--input",
                      data: {
                        "work-packages--activities-tab--comment-thread-target": "input",
                        action: "keydown.esc->work-packages--activities-tab--comment-thread#close " \
                                "keydown.meta+enter->work-packages--activities-tab--comment-thread#submit " \
                                "keydown.ctrl+enter->work-packages--activities-tab--comment-thread#submit"
                      } %>
    <div class="op-reply-form--buttons">
      <%= render(Primer::Beta::Button.new(type: :button, scheme: :secondary, size: :small, data: { action: "work-packages--activities-tab--comment-thread#close" })) { t(:button_cancel) } %>
      <%= render(Primer::Beta::Button.new(type: :submit, scheme: :primary, size: :small, ml: 2, data: { test_selector: "op-wp-journal-#{journal.id}-reply-submit" })) { t(:button_reply) } %>
    </div>
  <% end %>
  </div>
</div>
