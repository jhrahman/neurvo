<%=
  widget_wrapper do |container|
    if work_packages.empty?
      container.with_body(classes: "op-widget-box--empty") do
        render(Primer::Beta::Blankslate.new(test_selector: "my-work-widget-empty")) do |component|
          component.with_visual_icon(icon: :tasklist)
          component.with_heading(tag: :h3).with_content(I18n.t("neurvo.home.my_work.empty"))
          component.with_description { I18n.t("neurvo.home.my_work.empty_hint") }
        end
      end
    else
      work_packages.each do |work_package|
        container.with_row do
          render(Homescreen::WorkPackageRowComponent.new(work_package:)) do
            due_label(work_package)&.then { helpers.tag.span(it, class: ("neurvo-overdue" if overdue?(work_package))) }
          end
        end
      end

      container.with_footer(test_selector: "my-work-widget-footer") do
        render(Primer::Beta::Link.new(href: view_all_path)) { I18n.t("neurvo.home.my_work.view_all") }
      end
    end
  end
%>
