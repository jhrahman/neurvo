<%=
  widget_wrapper do |container|
    if sprints.empty?
      container.with_body(classes: "op-widget-box--empty") do
        render(Primer::Beta::Blankslate.new(test_selector: "active-sprints-widget-empty")) do |component|
          component.with_visual_icon(icon: :iterations)
          component.with_heading(tag: :h3).with_content(I18n.t("neurvo.home.sprints.empty"))
          component.with_description { I18n.t("neurvo.home.sprints.empty_hint") }
        end
      end
    else
      sprints.each do |sprint|
        container.with_row do
          progress = progress_for(sprint)
          helpers.tag.div(class: "neurvo-sprint", data: { test_selector: "neurvo-sprint" }) do
            helpers.safe_join([
              helpers.tag.div(class: "neurvo-sprint--head") do
                helpers.safe_join([
                  render(Primer::Beta::Link.new(href: backlog_path(sprint), font_weight: :bold)) { sprint.name },
                  helpers.tag.span("#{sprint.project.name} · #{days_left(sprint)}", class: "neurvo-sprint--meta")
                ])
              end,
              helpers.tag.p(goal_for(sprint), class: "neurvo-sprint--goal"),
              helpers.tag.div(class: "neurvo-progress", role: "progressbar", aria: { valuenow: progress.percent, valuemin: 0, valuemax: 100, label: sprint.name }) do
                helpers.tag.span(class: "neurvo-progress--bar", style: "width: #{progress.percent}%")
              end,
              helpers.tag.div(class: "neurvo-sprint--stats") do
                helpers.safe_join([
                  helpers.tag.span(I18n.t("neurvo.home.sprints.progress", done: progress.done, total: progress.total)),
                  helpers.tag.span(dates_for(sprint))
                ])
              end
            ])
          end
        end
      end
    end
  end
%>
