<%= form_with url: "/my/settings", method: :patch, data: { turbo: false }, html: { "aria-label": t(:label_interface) } do %>
  <%= render(Primer::Beta::ButtonGroup.new(size: :small, w: :full, test_selector: "op-color-mode-toggle")) do |group|
        [["light", :sun], ["dark", :moon]].each do |theme, icon|
          group.with_button(
            type: :submit,
            name: "pref[theme]",
            value: theme,
            scheme: User.current.pref.theme == theme ? :primary : :default,
            aria: { pressed: (User.current.pref.theme == theme).to_s },
            block: true,
            test_selector: "op-color-mode-#{theme}",
            flex: 1
          ) do |button|
            button.with_leading_visual_icon(icon:)
            button.with_trailing_visual_icon(icon: :check) if User.current.pref.theme == theme
            t("themes.#{theme}")
          end
        end
      end %>
  <%
    pref = User.current.pref
    palette_modes = case pref.theme
                    when "light" then %w[light]
                    when "dark" then %w[dark]
                    else %w[light dark]
                    end
  %>
  <% palette_modes.each do |mode| %>
    <% palettes = mode == "light" ? UserPreference::LIGHT_PALETTES : UserPreference::DARK_PALETTES %>
    <% current = pref.public_send("#{mode}_palette") %>
    <div class="neurvo-palette-swatches mt-2" role="group" aria-label="<%= t("themes.palette") %>">
      <% palettes.each do |palette| %>
        <% label = t("themes.palettes.#{mode}.#{palette}") %>
        <button type="submit"
                class="neurvo-swatch"
                name="pref[<%= mode %>_palette]"
                value="<%= palette %>"
                data-mode="<%= mode %>"
                data-palette="<%= palette %>"
                data-test-selector="op-palette-<%= mode %>-<%= palette %>"
                aria-pressed="<%= (current == palette).to_s %>"
                aria-label="<%= label %>"
                title="<%= label %>"></button>
      <% end %>
    </div>
  <% end %>
<% end %>
