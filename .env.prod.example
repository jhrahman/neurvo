# Copy to .env.prod and fill in. Never commit .env.prod.
# The deployment guide is docs/neurvo/DEPLOY.md.

NEURVO_HOST=neurvo.example.com        # public DNS name pointing at this server (no https://)
NEURVO_VERSION=latest                 # image tag; use a release tag to pin
POSTGRES_PASSWORD=change-me           # openssl rand -hex 24
SECRET_KEY_BASE=change-me             # openssl rand -hex 64 (keep it forever)

# The first administrator. The login name is always "admin".
NEURVO_ADMIN_EMAIL=you@example.com
NEURVO_ADMIN_PASSWORD=change-me       # use a long, unique password
#NEURVO_ADMIN_NAME=Neurvo Admin

# Optional tuning for a small server (defaults shown)
#NEURVO_WEB_WORKERS=1
#NEURVO_JOB_THREADS=5
